{
  "name": "@mice-operations/n8n-nodes-miceoperations",
  "version": "1.0.2",
  "description": "n8n community node for MICE Operations REST API",
  "license": "MIT",
  "homepage": "https://github.com/beerntea/n8n-nodes-miceoperations",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Wouter van Groesen",
    "email": "wouter@beerntea.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerntea/n8n-nodes-miceoperations.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/MiceoperationsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Miceoperations/Miceoperations.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.29.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
